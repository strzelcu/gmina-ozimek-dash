{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Konfiguracja punktów selektywnej zbiórki odpadów według gmin",
  "type": "object",
  "propertyNames": { "$ref": "#/definitions/text" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "address", "phone", "hours", "requirements", "accepted", "sourceUrl"],
    "properties": {
      "name": { "$ref": "#/definitions/text" },
      "address": { "$ref": "#/definitions/text" },
      "entrance": { "$ref": "#/definitions/text" },
      "phone": { "type": "string", "pattern": "^\\+[0-9]+(?: [0-9]+)*$" },
      "hours": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["days", "opens", "closes"],
          "properties": {
            "days": { "$ref": "#/definitions/text" },
            "opens": { "$ref": "#/definitions/time" },
            "closes": { "$ref": "#/definitions/time" }
          }
        }
      },
      "closed": { "$ref": "#/definitions/text" },
      "requirements": { "$ref": "#/definitions/text" },
      "accepted": { "$ref": "#/definitions/text" },
      "sourceUrl": { "type": "string", "format": "https-url" }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
  }
}
